// Auth + account schema (Phase 1: Accounts & Roles, SOW 2.i).
// Tables follow Better Auth's core model shape; app-specific columns are marked.
// Deliberately absent, by rule: SSN/bank/tax fields (P-1 — Stripe Connect Express owns KYC),
// medical/health fields (D-1), live location (D-3 — home port lives on profile models, coarse only).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // CREW offers services; BOAT books them (M-1 vocabulary). Admin flag is deliberately
  // not a signup option — operator accounts are promoted manually in the database.
  accountType String

  // Rule D-2: signup requires attesting the marketplace disclaimer; server stamps when.
  disclaimerAccepted   Boolean   @default(false)
  disclaimerAcceptedAt DateTime?

  sessions Session[]
  accounts Account[]
  bookings Booking[] @relation("BoatBookings")
  credentialDocs CredentialDoc[] @relation("UserCredentialDocs")

  @@unique([email])
  @@map("user")
}

// ---------- Booking Flow (SOW 2.i, docs/BOOKING_BRIEF.md) ----------
// State lives in packages/types booking-machine; every write goes through
// canTransition/transition. Money in integer cents (Stripe-ready). Deliberately
// absent, by rule: rating/penalty fields on decline (M-2), any clock-in or
// supervision fields (M-3) — TRIP_START/COMPLETE are attestation timestamps only.

model Booking {
  id            String @id @default(cuid())
  crewProfileId String // seed registry profile (crew accounts drive it via CrewProfileClaim)
  boatUserId    String
  boatUser      User   @relation("BoatBookings", fields: [boatUserId], references: [id], onDelete: Cascade)

  tripType  String
  dates     Json // ISO "YYYY-MM-DD" strings, coarse dates only (D-3)
  rateCents Int // crew-set rate basis × trip type × days — mechanical, never platform-set (M-2)
  feeCents  Int // itemized platform fee (P-3); side + % from one config constant, client decision open

  state String @default("REQUESTED")

  piAttestedAt  DateTime // D-4: boat attested P&I coverage on the request form
  requestedAt   DateTime  @default(now())
  acceptedAt    DateTime?
  fundsHeldAt   DateTime? // simulated until the Stripe Connect phase (client keys, SOW 6.i)
  tripStartedAt DateTime?
  completedAt   DateTime? // anchors the 48h delayed-payout window (P-2)
  closedAt      DateTime? // any terminal state
  updatedAt     DateTime  @updatedAt

  @@index([boatUserId])
  @@index([crewProfileId])
  @@map("booking")
}

// Demo bridge for the crew-identity gap (BOOKING_BRIEF): seed profiles are JSON,
// not user-owned; a claim lets one CREW account drive one registry profile.
// Replaced by real crew onboarding in a later phase.
model CrewProfileClaim {
  profileId String   @id
  userId    String   @unique
  createdAt DateTime @default(now())

  @@map("crew_profile_claim")
}

// ---------- Credential Verification (SOW 2.i, V-1/V-2) ----------
// The document itself lives in private S3/MinIO, presigned-only (V-2); this row
// is the structured record. Verification state is verifiedAt — a timestamp only
// the admin action writes. There is deliberately no client-writable boolean; only the
// admin action writes verifiedAt — enforced by that action, not by this schema (V-1).
// Nothing medical (D-1).

model CredentialDoc {
  id               String    @id @default(cuid())
  profileId        String // seed registry profile; uploader must hold its CrewProfileClaim
  uploadedByUserId String
  uploadedBy       User      @relation("UserCredentialDocs", fields: [uploadedByUserId], references: [id], onDelete: Cascade) // TODO(account-deletion): delete the S3 object BEFORE this cascade fires — the DB cascade alone orphans the doc (V-2)
  kind             String // Credential.kind values from packages/types only
  licenseClass     String?
  expiresAt        DateTime?
  s3Key            String    @unique // never logged (V-2)
  contentType      String
  sizeBytes        Int
  uploadedAt       DateTime  @default(now())
  verifiedAt       DateTime? // null = self-reported (V-1)
  verifiedByEmail  String?

  @@index([uploadedByUserId])
  @@index([profileId])
  @@map("credential_doc")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  issuer                String?
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}
